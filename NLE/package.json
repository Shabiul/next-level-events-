{
  "name": "thedecorparty",
  "private": true,
  "version": "1.0.0",
  "description": "TheDecorParty — Bangalore's #1 Surprise & Decoration Platform (Unified Fullstack Service)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch server/server.ts",
    "dev:frontend": "node scripts/wait-for-server.mjs && vite",
    "dev:frontend:nowait": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "tsx server/server.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:server",
    "migrate:supabase": "tsx server/src/scripts/migrate-mongo-to-supabase.ts",
    "test:supabase": "tsx server/src/scripts/test-supabase-connection.ts",
    "test:staff-sync": "tsx server/src/scripts/test-staff-supabase-sync.ts",
    "admin:create": "tsx server/src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@huggingface/inference": "^4.13.23",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.3",
    "@langchain/groq": "^1.3.1",
    "@langchain/ollama": "^1.3.0",
    "@langchain/textsplitters": "^1.0.1",
    "@supabase/supabase-js": "^2.114.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "faiss-node": "^0.5.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.43.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "mongoose": "^9.2.4",
    "motion": "^13.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "razorpay": "^2.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^3.0.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "react-toastify": "^11.0.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.1.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
