PORT=5000
NODE_ENV=development

# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ----------------------------------------------------------------------------
# In dev, leave empty to use relative /api proxy to :5000.
# In production on Vercel, requests to /api are same-origin.
VITE_API_URL=
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id
VITE_CRM_URL=http://localhost:3001

# ----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_DB_URL=postgresql://...

MONGODB_URI=mongodb://localhost:27017/eventdb

JWT_SECRET=your_jwt_secret_min_16_chars
SUPABASE_STORAGE_BUCKET=assets

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

FRONTEND_URL=http://localhost:3000
CRM_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

GROQ_API_KEY=your_groq_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_TOP_K=2

N8N_WEBHOOK_URL=
ADMIN_SECRET=your_admin_secret
