# ---- Core ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/thedecorparty

# Auth -- REQUIRED. Min 16 chars. Server refuses to start in production without it.
JWT_SECRET=

# Admin registration passphrase (min 8 chars). If unset, admin sign-up is disabled.
ADMIN_SECRET=

# ---- CORS ----
FRONTEND_URL=http://localhost:3000
# Optional extra allowed origins, comma-separated
CORS_ORIGINS=

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dev only: set to "true" to allow the offline mock payment simulator when
# Razorpay keys are absent. Ignored (never enabled) when NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=false

# ---- Email (optional; falls back to console mock) ----
EMAIL_USER=
EMAIL_PASS=
CONTACT_INBOX=

# ---- Phone OTP login (optional) ----
# Server generates/verifies the OTP regardless; this only picks the SMS carrier.
# With none set, dev logs the code to the console (never in production).
SMS_PROVIDER=            # twilio | msg91 | fast2sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
FAST2SMS_API_KEY=

# ---- Integrations (optional) ----
N8N_WEBHOOK_URL=
CLOUDINARY_URL=
