{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": false
  },
  "include": [
    "NLE/server/**/*.ts",
    "NLE/api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "CRM",
    "NLE/src",
    "NLE/dist",
    "NLE/dist-server",
    "_tools",
    "mongo_backup"
  ]
}
